      "why": "Skill SAPERE à vocation éditoriale / narrative (règle par préfixe)"
    },
    {
      "match": "^anthropic-skills:(analyse-|audit-|cartographie-|observatoire-|registre-|veille-geopolitique)",
      "model": "opus",
      "agent": "deep-reasoner",
      "why": "Skill SAPERE analytique transversale (règle par préfixe)"
    },
    {
      "match": "^anthropic-skills:",
      "model": "sonnet",
      "agent": "code-worker",
      "why": "Skill SAPERE non catégorisée (fallback)"
    },
    {
      "match": "(security|audit|threat|cve|vulnerability)",
      "model": "opus",
      "agent": "deep-reasoner",
      "why": "Mot-clé sécurité"
    },
    {
      "match": "^(data|statistical|forecast|modeling)",
      "model": "opus",
      "agent": "deep-reasoner",
      "why": "Mot-clé analyse profonde"
    },
    {
      "match": "^small-business:",
