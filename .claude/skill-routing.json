      "why": "Skill small-business (standard)"
    },
    {
      "match": "^(search|find|list|triage|digest)",
      "model": "haiku",
      "agent": "fast-scout",
      "why": "Mot-clé lecture rapide"
    },
    {
      "match": "(article|redige|rédige|portrait|reportage|edito|édito|blog|storytelling)",
